# Rename this file to .env before running the server

# Local MongoDB (if you have MongoDB installed locally)
MONGO_URI=mongodb://127.0.0.1:27017/campuspass

# OR use a free MongoDB Atlas cluster instead of local MongoDB:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campuspass

PORT=5000
JWT_SECRET=campuspass_super_secret_key_change_me
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
